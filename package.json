{
  "name": "little-minds-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Little Minds NestJS modular monolith API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db": "jest --config ./test/jest-db.json --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "bash scripts/db-reset-dev.sh",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "contracts:validate": "node scripts/contracts/validate.mjs",
    "contracts:compat": "node scripts/contracts/check-compatibility.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:check": "bash scripts/check-contracts.sh",
    "config:check": "bash scripts/check-env-secrets.sh"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.17.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.8",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.24",
    "@types/supertest": "6.0.3",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "jest": "30.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
