# Little Minds backend — local example (commit this file only; never commit .env)
# Copy to .env for local overrides. Values below are LOCAL-ONLY defaults — not secrets.

# --- Nest API (LMP-20; host process) ---
NODE_ENV=development
PORT=3000

# --- Docker Compose local services (LMP-21 / Blueprint §27.2) ---
# Host ports are configurable when defaults collide on your machine.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=little_minds
POSTGRES_PORT=5432

# Required by Prisma CLI (migrate/seed). Nest bootstrap still does not require it
# (product PrismaModule / readiness probes arrive in later tasks).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_minds?schema=public

# Destructive db:reset only. Must be set to 1 explicitly (CI sets this for prisma-checks).
# Remote hosts are always denied by scripts/db-reset-guard.ts regardless of this flag.
# LM_CONFIRM_DB_RESET=1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3-compatible endpoint for future object-storage adapters (not wired in Nest yet)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=little-minds-local

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMTP capture for future email/OTP adapters (not wired in Nest yet)
SMTP_HOST=localhost
SMTP_PORT=1025
