# Little Minds backend — local DEVELOPMENT example (commit this file only; never commit .env)
# Copy to .env for local overrides. Values below are LOCAL-ONLY defaults — not production secrets.
#
# Canonical product environments (cross-repo): development | staging | production
# See: docs/environments-config.md and infrastructure/environments/*.env.example

# =============================================================================
# PUBLIC configuration (safe to log / document / mirror in client build flavors)
# =============================================================================

# Product environment — exact names shared with little-minds-client
APP_ENV=development

# Node/Nest runtime (development | test | production). Staging deploys use NODE_ENV=production + APP_ENV=staging.
NODE_ENV=development

PORT=3000

# URL this API deployment expects clients to call (Flutter dart-define LM_API_BASE_URL must match).
# Development defaults: iOS Simulator http://localhost:3000 · Android Emulator http://10.0.2.2:3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Public release id for structured logs (ADR-013). Defaults to "dev" when unset.
# RELEASE=dev

# =============================================================================
# SECRET configuration (never commit real values; never log raw)
# =============================================================================

# --- Docker Compose local services (LMP-21 / Blueprint §27.2) ---
# Host ports are configurable when defaults collide on your machine.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=little_minds
POSTGRES_PORT=5432

# Required by Prisma CLI (migrate/seed). Nest development liveness does not require it;
# APP_ENV=staging|production Nest boot DOES require a non-local DATABASE_URL (LMP-28).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_minds?schema=public

# Destructive db:reset only. Must be set to 1 explicitly (CI sets this for prisma-checks).
# Remote hosts are always denied by scripts/db-reset-guard.ts regardless of this flag.
# LM_CONFIRM_DB_RESET=1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3-compatible endpoint for future object-storage adapters (not wired in Nest yet)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=little-minds-local

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMTP capture for future email/OTP adapters (not wired in Nest yet)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- LMP-33 / ADR-019 parent session secrets (staging/production required) ---
# Local development may omit PEMs (ephemeral Ed25519 keys generated at boot).
# REFRESH_TOKEN_PEPPER defaults to a local-only value when unset in development.
# JWT_ACCESS_PRIVATE_KEY_PEM=
# JWT_ACCESS_PUBLIC_KEY_PEM=
# JWT_PREVIOUS_PUBLIC_KEY_PEM=
# JWT_KEY_ID=local-dev
# JWT_ISSUER=little-minds-backend
# JWT_AUDIENCE=little-minds-parent
# REFRESH_TOKEN_PEPPER=
# AUTH_DEV_BOOTSTRAP_ENABLED=false
# AUTH_DEV_BOOTSTRAP_PARENT_ALLOWLIST=11111111-1111-4111-8111-111111111111

# Reserved for later Billing / email OTP — do not invent production values here.
# JWT_SECRET=   # legacy placeholder — unused by ADR-019 Ed25519 access JWTs
# OIDC_CLIENT_SECRET=
# SMTP_PASSWORD=
