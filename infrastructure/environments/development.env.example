# APP_ENV=development — local-only placeholders (safe to copy to gitignored .env)
# Mirror of root .env.example public + secret split. Prefer copying root .env.example for Compose.

# --- PUBLIC ---
APP_ENV=development
NODE_ENV=development
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000

# --- SECRET (local Compose defaults only) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_minds?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=little_minds
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
