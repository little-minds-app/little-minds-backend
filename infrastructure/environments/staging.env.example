# APP_ENV=staging — PLACEHOLDERS ONLY. Inject real values via a staging secret store / GitHub Environment.
# Do not commit real credentials. Hostnames are TECHNICAL ASSUMPTIONS until LMP-29 provisioning.

# --- PUBLIC ---
APP_ENV=staging
NODE_ENV=production
PORT=3000
# Clients set LM_API_BASE_URL (Flutter dart-define) to this same value for the staging flavor.
PUBLIC_API_BASE_URL=https://api.staging.example.invalid

# --- SECRET (replace CHANGE_ME_* via secret store; never use local postgres/minioadmin defaults) ---
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/little_minds_staging?schema=public
# POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
# MINIO_ROOT_PASSWORD=CHANGE_ME_OBJECT_STORE_SECRET
# S3_SECRET_KEY=CHANGE_ME_OBJECT_STORE_SECRET
# JWT_SECRET=CHANGE_ME_JWT_SECRET
# OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
