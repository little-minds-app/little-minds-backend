{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/test/prisma-integrity.spec.ts",
    "<rootDir>/test/identity-session.db.spec.ts",
    "<rootDir>/test/web-parent-session.db.spec.ts",
    "<rootDir>/test/phone-otp.db.spec.ts",
    "<rootDir>/test/multi-provider-auth.db.spec.ts",
    "<rootDir>/test/account-linking.db.spec.ts",
    "<rootDir>/test/step-up.db.spec.ts",
    "<rootDir>/test/phone-identity-lock.db.spec.ts",
    "<rootDir>/test/child-profile.db.spec.ts",
    "<rootDir>/test/child-profile-security.db.spec.ts",
    "<rootDir>/test/parent-profile.db.spec.ts",
    "<rootDir>/test/activity-ingestion.db.spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node"
}
