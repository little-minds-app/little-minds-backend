// Little Minds — PostgreSQL canonical persistence (LMP-22)
// Source of truth: Blueprint §13 catalog + §38 refinements (§38 wins on conflict).
// Mapping / open questions: prisma/MAPPING.md
// UUIDv4 via Prisma uuid() for Day 1; UUIDv7 preference (§38.1) is an open question.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — only values stated clearly in Blueprint §38 / §33. Invented product
// enums are deferred (see prisma/MAPPING.md unresolved decisions).
// ---------------------------------------------------------------------------

enum ParentAccountLifecycle {
  active
  pending_deletion
  deleted
}

enum ConsentStatus {
  granted
  withdrawn
  not_asked
}

enum ReviewStatus {
  draft
  in_review
  rejected
  approved
  published
  archived
}

enum SubscriptionLifecycle {
  ACTIVE
  GRACE_PERIOD
  BILLING_RETRY
  CANCELLED_RENEWAL
  EXPIRED
  REVOKED
}

enum DeletionRequestStatus {
  requested
  in_progress
  completed
  failed
  cancelled
}

enum SyncStatus {
  pending
  acknowledged
  rejected
  conflict
}

enum ProfileDraftStatus {
  pending
  accepted
  skipped
  expired
  deleted
}

enum ParentSessionRevokeReason {
  logout
  logout_all
  refresh_reuse
  admin_revoke
  account_deletion
  expired
  security_event
  session_limit
}

/// LMP-36 — privacy-safe account link attempt outcomes (no PII / no other-parent ids).
enum AccountLinkOutcome {
  linked
  already_linked
  collision_other_parent
  collision_unlinked
  collision_race
  invalid_proof
  rate_limited
}

/// LMP-34 / ADR-020 — OTP challenge lifecycle
enum OtpChallengeStatus {
  pending
  consumed
  expired
  locked
  superseded
}

/// LMP-34 / ADR-020 — SMS delivery state (adapter result tracking)
enum OtpDeliveryState {
  pending_send
  sent
  failed
  superseded
}

// ===========================================================================
// 13.1 / 38.2 — Identity, consent, profile
// ===========================================================================

model ParentAccount {
  id          String                 @id @default(uuid()) @db.Uuid
  authSubject String?                @map("auth_subject")
  locale      String                 @default("tr-TR")
  timezone    String                 @default("Europe/Istanbul")
  lifecycle   ParentAccountLifecycle @default(active)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(6)

  identities                     ParentIdentity[]
  profile                        ParentProfile?
  parentGatePin                  ParentGatePin?
  parentGateGrants               ParentGateGrant[]
  profileDrafts                  ProfileDraft[]
  privacyNoticeAcknowledgments   PrivacyNoticeAcknowledgment[]
  processingPreferences          ProcessingPreference[]
  children                       ChildProfile[]
  devices                        Device[]
  consentRecords                 ConsentRecord[]
  subscriptions                  Subscription[]
  entitlements                   Entitlement[]
  offlineEntitlementGrants       OfflineEntitlementGrant[]
  deletionRequests               DeletionRequest[]
  parentPreferences              ParentPreference[]
  sessions                       ParentSession[]
  webSessions                    WebParentSession[]
  accountLinkAudits              AccountLinkAudit[]
  parentActivityEvents            ParentActivityEvent[]

  @@map("parent_accounts")
}

/// Parent auth session (ADR-019 / LMP-33). Refresh token plaintext is never stored.
model ParentSession {
  id                      String                     @id @default(uuid()) @db.Uuid
  parentId                String                     @map("parent_id") @db.Uuid
  tokenFamilyId           String                     @map("token_family_id") @db.Uuid
  refreshTokenHash        String?                    @map("refresh_token_hash")
  /// Bounded ring of prior hashes for reuse detection — max 8 entries; never plaintext tokens
  refreshTokenHashHistory Json                       @default("[]") @map("refresh_token_hash_history")
  refreshGeneration       Int                        @default(0) @map("refresh_generation")
  expiresAt               DateTime                   @map("expires_at") @db.Timestamptz(6)
  revokedAt               DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokedReason           ParentSessionRevokeReason? @map("revoked_reason")
  deviceId                String?                    @map("device_id") @db.Uuid
  /// Coarse client surface only — not a fingerprint
  clientSurface           String?                    @map("client_surface")
  userAgentSummary        String?                    @map("user_agent_summary")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastRefreshedAt         DateTime?                  @map("last_refreshed_at") @db.Timestamptz(6)

  parent       ParentAccount                     @relation(fields: [parentId], references: [id], onDelete: Restrict)
  device       Device?                           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  priorHashes  ParentSessionRefreshHashLookup[]
  parentGateGrants ParentGateGrant[]
  webSessions  WebParentSession[]

  @@unique([refreshTokenHash], map: "parent_sessions_refresh_token_hash_key")
  @@index([parentId, revokedAt], map: "parent_sessions_parent_revoked_idx")
  @@index([tokenFamilyId], map: "parent_sessions_token_family_idx")
  @@index([expiresAt], map: "parent_sessions_expires_at_idx")
  @@map("parent_sessions")
}

/// Indexed prior refresh hashes for O(1) reuse detection (no scan limit).
model ParentSessionRefreshHashLookup {
  hash      String        @id @db.VarChar(64)
  sessionId String        @map("session_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  session   ParentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "parent_session_refresh_hash_lookups_session_idx")
  @@map("parent_session_refresh_hash_lookups")
}

/// LMP-38 — opaque browser session, bound to the canonical parent session.
/// Web clients never hold or rotate backend refresh tokens.
model WebParentSession {
  id              String    @id @default(uuid()) @db.Uuid
  parentId        String    @map("parent_id") @db.Uuid
  parentSessionId String    @unique @map("parent_session_id") @db.Uuid
  handleHash      String    @unique @map("handle_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)

  parent        ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  parentSession ParentSession @relation(fields: [parentSessionId], references: [id], onDelete: Cascade)

  @@index([parentId, revokedAt], map: "web_parent_sessions_parent_revoked_idx")
  @@index([expiresAt], map: "web_parent_sessions_expires_at_idx")
  @@map("web_parent_sessions")
}

/// LMP-34 / ADR-020 — LM-owned OTP challenges (no plaintext OTP / E.164 at rest).
model OtpChallenge {
  id                   String             @id @default(uuid()) @db.Uuid
  provider             String
  subjectKey           String             @map("subject_key")
  codeHash             String             @map("code_hash")
  status               OtpChallengeStatus @default(pending)
  deliveryState        OtpDeliveryState   @default(pending_send) @map("delivery_state")
  attemptCount         Int                @default(0) @map("attempt_count")
  sendCount            Int                @default(0) @map("send_count")
  expiresAt            DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?          @map("consumed_at") @db.Timestamptz(6)
  lastSentAt           DateTime?          @map("last_sent_at") @db.Timestamptz(6)
  /// Optional short-lived sealed destination; null by default (ADR-020 U9).
  sealedDestination    String?            @map("sealed_destination")
  noticeVersion        String             @map("notice_version")
  noticeLocale         String             @map("notice_locale")
  noticePresentedAt    DateTime           @map("notice_presented_at") @db.Timestamptz(6)
  presentationSurface  String?            @map("presentation_surface")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveryAttempts OtpDeliveryAttempt[]

  @@index([provider, subjectKey], map: "otp_challenges_provider_subject_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@index([createdAt], map: "otp_challenges_created_at_idx")
  @@map("otp_challenges")
}

/// FK-safe delivery evidence (ADR-020 §13.1): ON DELETE SET NULL + snapshot; no CASCADE.
model OtpDeliveryAttempt {
  id                  String        @id @default(uuid()) @db.Uuid
  challengeId         String?       @map("challenge_id") @db.Uuid
  challengeIdSnapshot String        @map("challenge_id_snapshot") @db.Uuid
  adapter             String
  result              String
  providerMessageId   String?       @map("provider_message_id")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge OtpChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([challengeId], map: "otp_delivery_attempts_challenge_idx")
  @@index([challengeIdSnapshot], map: "otp_delivery_attempts_challenge_snapshot_idx")
  @@index([createdAt], map: "otp_delivery_attempts_created_at_idx")
  @@map("otp_delivery_attempts")
}

/// Durable multi-replica SMS/verify abuse counters (ADR-020 §8.1).
model OtpAbuseCounter {
  bucketType  String   @map("bucket_type")
  bucketKey   String   @map("bucket_key")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  sendCount   Int      @default(0) @map("send_count")
  verifyCount Int      @default(0) @map("verify_count")

  @@id([bucketType, bucketKey, windowStart], map: "otp_abuse_counters_pkey")
  @@map("otp_abuse_counters")
}

/// Server-issued OIDC nonces for Apple / Google ID-token paths (ADR-021).
/// Plaintext nonce is returned once to the client; only the hash is stored.
model AuthOidcNonce {
  id         String    @id @default(uuid()) @db.Uuid
  /// Hex SHA-256 of the plaintext nonce (single-use consume).
  nonceHash  String    @unique @map("nonce_hash")
  /// apple | google (provider-bound; cross-provider consume rejected)
  provider   String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_oidc_nonces_expires_at_idx")
  @@map("auth_oidc_nonces")
}

/// Server-issued one-time OAuth/PKCE transactions (ADR-021 Google PKCE path).
/// Bound to client_id + redirect_uri + code_challenge; atomic single-use consume.
model AuthOauthTransaction {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Hex SHA-256 of opaque state returned to the client.
  stateHash            String    @unique @map("state_hash")
  provider             String
  clientId             String    @map("client_id")
  redirectUri          String    @map("redirect_uri")
  codeChallenge        String    @map("code_challenge")
  codeChallengeMethod  String    @default("S256") @map("code_challenge_method")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_oauth_transactions_expires_at_idx")
  @@map("auth_oauth_transactions")
}

/// Provider-linked identity. Unique active (provider, provider_subject).
model ParentIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  parentId        String    @map("parent_id") @db.Uuid
  provider        String
  providerSubject String    @map("provider_subject")
  /// Minimized verified contact when needed; never use as merge key alone.
  verifiedContact String?   @map("verified_contact")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  linkedAt        DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt      DateTime? @map("unlinked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject], map: "parent_identities_provider_subject_key")
  @@index([parentId])
  @@map("parent_identities")
}

/// LMP-36 P1 — server-issued recent-auth / step-up challenge for sensitive ops.
/// Bound to parent + session + purpose; opaque token hashed at rest; single-use.
/// Access-token refresh alone does NOT mint a step-up.
model AuthStepUpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  /// Hex SHA-256 of opaque step_up_token returned once to the client.
  tokenHash   String    @unique @map("token_hash")
  parentId    String    @map("parent_id") @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  /// e.g. identity_link — prevents reuse across operation classes
  purpose     String
  /// Provider of the *existing* identity used to prove recent control
  provider    String
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId, purpose], map: "auth_step_up_challenges_parent_purpose_idx")
  @@index([expiresAt], map: "auth_step_up_challenges_expires_at_idx")
  @@map("auth_step_up_challenges")
}

/// Restricted account-link audit (Blueprint §29.4). Never store email/phone/raw
/// provider subjects — only a keyed hash for correlation. No public API.
model AccountLinkAudit {
  id                    String             @id @default(uuid()) @db.Uuid
  parentId              String             @map("parent_id") @db.Uuid
  sessionId             String?            @map("session_id") @db.Uuid
  provider              String
  /// SHA-256 hex of "link_audit_v1|" || provider || "|" || provider_subject
  providerSubjectHash   String             @map("provider_subject_hash")
  outcome               AccountLinkOutcome
  identityId            String?            @map("identity_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)

  @@index([parentId, createdAt], map: "account_link_audits_parent_created_idx")
  @@index([provider, createdAt], map: "account_link_audits_provider_created_idx")
  @@index([outcome, createdAt], map: "account_link_audits_outcome_created_idx")
  @@map("account_link_audits")
}

/// Canonical optional parent profile (§38). Replaces §13 parent_demographics as a table.
model ParentProfile {
  parentId                 String   @id @map("parent_id") @db.Uuid
  firstName                String?  @map("first_name")
  lastName                 String?  @map("last_name")
  ageBandOptional          String?  @map("age_band_optional")
  genderOptional           String?  @map("gender_optional")
  numberOfChildrenOptional Int?     @map("number_of_children_optional")
  occupationOptional       String?  @map("occupation_optional")
  collectionNoticeVersion  String?  @map("collection_notice_version")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

model ProfileDraft {
  id               String             @id @default(uuid()) @db.Uuid
  parentId         String             @map("parent_id") @db.Uuid
  /// Encrypted temporary provider-supplied name blob; never log plaintext.
  encryptedPayload String             @map("encrypted_payload")
  expiresAt        DateTime           @map("expires_at") @db.Timestamptz(6)
  status           ProfileDraftStatus @default(pending)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, status])
  @@map("profile_drafts")
}

model PrivacyNoticeAcknowledgment {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String   @map("parent_id") @db.Uuid
  noticeVersion  String   @map("notice_version")
  locale         String
  presentedAt    DateTime @map("presented_at") @db.Timestamptz(6)
  acknowledgedAt DateTime @map("acknowledged_at") @db.Timestamptz(6)
  surface        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@map("privacy_notice_acknowledgments")
}

model ProcessingPreference {
  id            String        @id @default(uuid()) @db.Uuid
  parentId      String        @map("parent_id") @db.Uuid
  purpose       String
  status        ConsentStatus
  legalBasis    String        @map("legal_basis")
  policyVersion String        @map("policy_version")
  changedAt     DateTime      @map("changed_at") @db.Timestamptz(6)
  source        String
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, purpose])
  @@map("processing_preferences")
}

model ChildProfile {
  id                           String    @id @default(uuid()) @db.Uuid
  parentId                     String    @map("parent_id") @db.Uuid
  nicknameOptional             String?   @map("nickname_optional")
  ageMonthsAtReference         Int       @map("age_months_at_reference")
  ageReferenceDate             DateTime  @map("age_reference_date") @db.Date
  preferredLocale              String    @default("tr-TR") @map("preferred_locale")
  timezone                     String?   @default("Europe/Istanbul")
  accessibilityPreferencesJson Json?     @map("accessibility_preferences_json")
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent                  ParentAccount           @relation(fields: [parentId], references: [id], onDelete: Restrict)
  preferences             ParentPreference?
  devices                 Device[]
  kidsModeAuthorizations  KidsModeAuthorization[]
  consentRecords          ConsentRecord[]
  mentorRecommendations   MentorRecommendation[]
  missionFeedback         MissionFeedback[]
  parentReflections       ParentReflection[]
  activitySessions        ActivitySession[]
  skillObservations       SkillObservation[]
  skillStates             SkillState[]
  dailyUsageAggregates    DailyUsageAggregate[]
  activityAggregates      ActivityAggregate[]
  insights                Insight[]
  screenTimePolicies      ScreenTimePolicy[]
  screenTimeIntervals     ScreenTimeInterval[]
  screenTimeResetHistory  ScreenTimeResetHistory[]
  syncCursors             SyncCursor[]

  @@index([parentId, deletedAt], map: "child_profiles_parent_id_deleted_at_idx")
  @@map("child_profiles")
}

model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  parentId      String         @map("parent_id") @db.Uuid
  childId       String?        @map("child_id") @db.Uuid
  purpose       String
  policyVersion String         @map("policy_version")
  status        ConsentStatus
  recordedAt    DateTime       @map("recorded_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  source        String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  child  ChildProfile? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([childId])
  @@map("consent_records")
}

model ParentPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  parentId           String   @map("parent_id") @db.Uuid
  childId            String   @unique @map("child_id") @db.Uuid
  availableMaterials Json?    @map("available_materials")
  timeBudget         Json?    @map("time_budget")
  sensoryPreferences Json?    @map("sensory_preferences")
  coPlayPreference   String?  @map("co_play_preference")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child  ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@map("parent_preferences")
}

model Device {
  id                String    @id @default(uuid()) @db.Uuid
  parentId          String    @map("parent_id") @db.Uuid
  childId           String?   @map("child_id") @db.Uuid
  platform          String
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastPolicyVersion String?   @map("last_policy_version")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Installation / key reference (opaque); no hardware fingerprint.
  installKeyRef     String?   @map("install_key_ref")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                 ParentAccount            @relation(fields: [parentId], references: [id], onDelete: Restrict)
  child                  ChildProfile?            @relation(fields: [childId], references: [id], onDelete: SetNull)
  kidsModeAuthorizations KidsModeAuthorization[]
  activitySessions       ActivitySession[]
  activityEvents         ActivityEvent[]
  screenTimeIntervals    ScreenTimeInterval[]
  syncCursors            SyncCursor[]
  offlineEntitlementGrants OfflineEntitlementGrant[]
  parentSessions           ParentSession[]

  @@index([parentId])
  @@index([childId])
  @@map("devices")
}

/// §38.2 new — at most one active server-authorized row per child (partial unique in SQL).
model KidsModeAuthorization {
  id                String    @id @default(uuid()) @db.Uuid
  childId           String    @map("child_id") @db.Uuid
  deviceId          String    @map("device_id") @db.Uuid
  generation        Int
  activatedAt       DateTime  @map("activated_at") @db.Timestamptz(6)
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz(6)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  credentialRef     String    @map("credential_ref")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([childId])
  @@index([deviceId])
  @@map("kids_mode_authorizations")
}

// ===========================================================================
// 13.2 — Curriculum / content
// ===========================================================================

model LearningDomain {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  labelKey String @map("label_key")

  learningGoals LearningGoal[]
  skillTags     SkillTag[]

  @@map("learning_domains")
}

model LearningGoal {
  id           String @id @default(uuid()) @db.Uuid
  domainId     String @map("domain_id") @db.Uuid
  objectiveKey String @map("objective_key")
  evidenceRefs Json?  @map("evidence_refs")
  reviewStatus ReviewStatus @default(draft) @map("review_status")

  domain              LearningDomain       @relation(fields: [domainId], references: [id], onDelete: Restrict)
  activityDefinitions ActivityDefinition[]

  @@index([domainId])
  @@map("learning_goals")
}

model SkillTag {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  domainId       String @map("domain_id") @db.Uuid
  descriptionKey String @map("description_key")

  domain            LearningDomain     @relation(fields: [domainId], references: [id], onDelete: Restrict)
  skillObservations SkillObservation[]
  skillStates       SkillState[]

  @@index([domainId])
  @@map("skill_tags")
}

model Theme {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  paletteTokenRef String?      @map("palette_token_ref")
  narrativeKey    String?      @map("narrative_key")
  status          ReviewStatus @default(draft)

