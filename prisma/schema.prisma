  @@unique([childId, localDate, timezone, definitionVersion])
  @@map("daily_usage_aggregates")
}

model ActivityAggregate {
  id                     String   @id @default(uuid()) @db.Uuid
  childId                String   @map("child_id") @db.Uuid
  contentVersionId       String   @map("content_version_id") @db.Uuid
