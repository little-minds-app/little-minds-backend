  skillTag        SkillTag         @relation(fields: [skillTagId], references: [id], onDelete: Restrict)
  activityVariant ActivityVariant? @relation(fields: [activityVariantId], references: [id], onDelete: SetNull)

  @@index([childId])
  @@map("skill_observations")
}

model SkillState {
  childId       String   @map("child_id") @db.Uuid
  skillTagId    String   @map("skill_tag_id") @db.Uuid
  scaffoldLevel String?  @map("scaffold_level")
  evidenceCount Int      @default(0) @map("evidence_count")
  ruleVersion   String   @map("rule_version")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  child    ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
