model GameMechanic {
  id                String @id @default(uuid()) @db.Uuid
  code              String @unique
  engineVersion     String @map("engine_version")
  inputCapabilities Json?  @map("input_capabilities")

  activityDefinitions ActivityDefinition[]

  @@map("game_mechanics")
}

model ActivityDefinition {
  id             String       @id @default(uuid()) @db.Uuid
  mechanicId     String       @map("mechanic_id") @db.Uuid
  learningGoalId String       @map("learning_goal_id") @db.Uuid
  /// Skill tag IDs as JSON array until join-table normalization is decided.
  skillTags      Json?        @map("skill_tags")
  minAgeMonths   Int          @map("min_age_months")
  maxAgeMonths   Int          @map("max_age_months")
  safetyClass    String       @map("safety_class")
  status         ReviewStatus @default(draft)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  mechanic GameMechanic      @relation(fields: [mechanicId], references: [id], onDelete: Restrict)
  goal     LearningGoal      @relation(fields: [learningGoalId], references: [id], onDelete: Restrict)
  variants ActivityVariant[]

  @@index([mechanicId])
  @@index([learningGoalId])
  @@map("activity_definitions")
}

/// Immutable published activity variant. Day-1 stand-in for content_version_id (§38 open: separate content_versions table).
model ActivityVariant {
  id               String       @id @default(uuid()) @db.Uuid
  activityId       String       @map("activity_id") @db.Uuid
  version          Int
  difficulty       String?
  scaffoldLevel    String?      @map("scaffold_level")
  themeId          String?      @map("theme_id") @db.Uuid
  locale           String       @default("tr-TR")
  configurationJson Json?       @map("configuration_json")
  assetManifestId  String?      @map("asset_manifest_id") @db.Uuid
  reviewStatus     ReviewStatus @default(draft) @map("review_status")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity           ActivityDefinition  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  theme              Theme?              @relation(fields: [themeId], references: [id], onDelete: SetNull)
  assetManifest      AssetManifest?      @relation(fields: [assetManifestId], references: [id], onDelete: SetNull)
  activitySessions   ActivitySession[]
  activityEvents     ActivityEvent[]
  skillObservations  SkillObservation[]
  activityAggregates ActivityAggregate[]

  @@unique([activityId, version])
  @@index([themeId])
  @@map("activity_variants")
}

model MonthlyPack {
  id             String       @id @default(uuid()) @db.Uuid
  ageMonth       Int          @map("age_month")
  locale         String
  themeId        String?      @map("theme_id") @db.Uuid
