  validUntil           DateTime? @map("valid_until") @db.Timestamptz(6)
  offlineAccessUntil   DateTime? @map("offline_access_until") @db.Timestamptz(6)
  sourceSubscriptionId String?   @map("source_subscription_id") @db.Uuid
  status               String
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent             ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Restrict)
  sourceSubscription Subscription?  @relation(fields: [sourceSubscriptionId], references: [id], onDelete: SetNull)

  @@index([parentId, featureKey])
  @@map("entitlements")
}

model OfflineEntitlementGrant {
  id                   String    @id @default(uuid()) @db.Uuid
  parentId             String    @map("parent_id") @db.Uuid
  deviceId             String    @map("device_id") @db.Uuid
  issuedAt             DateTime  @map("issued_at") @db.Timestamptz(6)
  storeValidUntil      DateTime  @map("store_valid_until") @db.Timestamptz(6)
  offlineAccessUntil   DateTime  @map("offline_access_until") @db.Timestamptz(6)
  signatureKeyId       String    @map("signature_key_id")
  revocationGeneration Int       @default(0) @map("revocation_generation")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  device Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([parentId, deviceId])
  @@map("offline_entitlement_grants")
}

model SyncCursor {
  id                         String   @id @default(uuid()) @db.Uuid
  deviceId                   String   @map("device_id") @db.Uuid
  childId                    String   @map("child_id") @db.Uuid
  lastUploadedEventId        String?  @map("last_uploaded_event_id") @db.Uuid
  lastDownloadedPolicyVersion String? @map("last_downloaded_policy_version")
  lastSyncAt                 DateTime? @map("last_sync_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  device Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([deviceId, childId])
  @@map("sync_cursors")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actorId          String   @map("actor_id")
  actorRole        String   @map("actor_role")
  action           String
  resourceType     String   @map("resource_type")
  resourceId       String   @map("resource_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  metadataRedacted Json?    @map("metadata_redacted")

  @@index([actorId, createdAt], map: "audit_logs_actor_id_created_at_idx")
  @@map("audit_logs")
}

model DeletionRequest {
  id          String                @id @default(uuid()) @db.Uuid
  parentId    String                @map("parent_id") @db.Uuid
  scope       String
  requestedAt DateTime              @map("requested_at") @db.Timestamptz(6)
  status      DeletionRequestStatus @default(requested)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(6)
  /// Retention exceptions / legal hold references (opaque).
  retentionNotes String?            @map("retention_notes")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)

  @@index([parentId, status])
  @@map("deletion_requests")
}

/// Parent Gate PIN lock state (LMP-42).
/// Only a salted, stretched hash is persisted. Raw PINs and gate grants
/// must never be written to this table or to logs.
model ParentGatePin {
  parentId        String        @id @map("parent_id") @db.Uuid
  salt            String        @db.VarChar(64)
  pinHash         String        @map("pin_hash") @db.VarChar(128)
  failedAttempts  Int           @default(0) @map("failed_attempts")
  lockedUntil     DateTime?     @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent          ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("parent_gate_pins")
}

/** Opaque, short-lived, single adult area authorization, bound to session. */
model ParentGateGrant {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  parentId String @map("parent_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  session ParentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([parentId, sessionId, expiresAt])
  @@map("parent_gate_grants")
}
