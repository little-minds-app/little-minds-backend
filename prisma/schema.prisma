/// id is the canonical play_session_id (§38 naming).
model ActivitySession {
  id                       String    @id @default(uuid()) @db.Uuid
  childId                  String    @map("child_id") @db.Uuid
  /// Day-1: FK to activity_variants.id (content_version_id).
  contentVersionId         String    @map("content_version_id") @db.Uuid
  startedAt                DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt                  DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSeconds          Int?      @map("duration_seconds")
  monotonicDurationSeconds Int?      @map("monotonic_duration_seconds")
  completionStatus         String?   @map("completion_status")
  deviceId                 String?   @map("device_id") @db.Uuid
  schemaVersion            String    @map("schema_version")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  child          ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentVersion ActivityVariant @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  events         ActivityEvent[]
  screenTimeIntervals ScreenTimeInterval[]

  @@index([childId, startedAt], map: "activity_sessions_child_id_started_at_idx")
  @@map("activity_sessions")
}

model ActivityEvent {
  eventId                  String   @id @map("event_id") @db.Uuid
  playSessionId            String   @map("play_session_id") @db.Uuid
  childId                  String   @map("child_id") @db.Uuid
  deviceId                 String?  @map("device_id") @db.Uuid
  contentVersionId         String   @map("content_version_id") @db.Uuid
  eventType                String   @map("event_type")
  occurredAt               DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt               DateTime @map("received_at") @db.Timestamptz(6)
  monotonicDurationSeconds Int?     @map("monotonic_duration_seconds")
  payloadJson              Json?    @map("payload_json")
  schemaVersion            String   @map("schema_version")
  consentScope             String   @map("consent_scope")

  playSession    ActivitySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  contentVersion ActivityVariant @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([childId, receivedAt], map: "activity_events_child_id_received_at_idx")
  @@map("activity_events")
}

/// Parent-only telemetry: no fabricated child play session (LMP-51).
/// Future ingestion enforces authenticated parent ownership and server consent.
/// Cross-table global idempotency claim for both child and parent activity events.
/// The ingest service creates this record and its destination event atomically.
model ActivityIngestKey {
  eventId            String   @id @map("event_id") @db.Uuid
  parentId           String   @map("parent_id") @db.Uuid
  payloadFingerprint String   @map("payload_fingerprint") @db.VarChar(64)
  eventClass         String   @map("event_class") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId, createdAt], map: "activity_ingest_keys_parent_created_idx")
  @@map("activity_ingest_keys")
}

model ParentActivityEvent {
  eventId                  String    @id @map("event_id") @db.Uuid
  parentId                 String    @map("parent_id") @db.Uuid
  deviceId                 String    @map("device_id") @db.Uuid
  contentVersionId         String    @map("content_version_id") @db.Uuid
  eventType                String    @map("event_type")
  occurredAt               DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt               DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadJson              Json      @map("payload_json")
  schemaVersion            String    @map("schema_version")
  consentScope             String    @map("consent_scope")
  consentPolicyVersion     String    @map("consent_policy_version")
  payloadFingerprint       String    @map("payload_fingerprint") @db.VarChar(64)

  parent                   ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, receivedAt], map: "parent_activity_events_parent_received_idx")
  @@map("parent_activity_events")
}

model SkillObservation {
