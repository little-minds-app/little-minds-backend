  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  theme Theme?            @relation(fields: [themeId], references: [id], onDelete: SetNull)
  items MonthlyPackItem[]

  @@index([ageMonth, locale, releaseChannel, status], map: "monthly_packs_age_locale_channel_status_idx")
  @@map("monthly_packs")
}

model MonthlyPackItem {
  id         String  @id @default(uuid()) @db.Uuid
  packId     String  @map("pack_id") @db.Uuid
  itemType   String  @map("item_type")
  itemId     String  @map("item_id") @db.Uuid
  priority   Int     @default(0)
  sequence   Int     @default(0)
  isOptional Boolean @default(false) @map("is_optional")

  pack MonthlyPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("monthly_pack_items")
}

model AssetManifest {
  id                String       @id @default(uuid()) @db.Uuid
