model Subscription {
  id                     String                 @id @default(uuid()) @db.Uuid
  parentId               String                 @map("parent_id") @db.Uuid
  store                  String
  productId              String                 @map("product_id")
  status                 SubscriptionLifecycle
  currentPeriodEnd       DateTime?              @map("current_period_end") @db.Timestamptz(6)
  storeValidUntil        DateTime?              @map("store_valid_until") @db.Timestamptz(6)
  lastVerifiedAt         DateTime?              @map("last_verified_at") @db.Timestamptz(6)
  revokedAt              DateTime?              @map("revoked_at") @db.Timestamptz(6)
  autoRenewStatus        String?                @map("auto_renew_status")
  originalTransactionRef String?                @map("original_transaction_ref")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent       ParentAccount          @relation(fields: [parentId], references: [id], onDelete: Restrict)
  transactions PurchaseTransaction[]
  entitlements Entitlement[]

  @@index([parentId, status], map: "subscriptions_parent_id_status_idx")
  @@map("subscriptions")
}

model PurchaseTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  subscriptionId        String   @map("subscription_id") @db.Uuid
  store                 String
  storeEventId          String?  @map("store_event_id")
  originalTransactionRef String? @map("original_transaction_ref")
  eventType             String   @map("event_type")
  verifiedAt            DateTime @map("verified_at") @db.Timestamptz(6)
  payloadHash           String   @map("payload_hash")
  statusTransition      String?  @map("status_transition")
  /// Encrypted/restricted external refs — never log plaintext tokens.
  encryptedExternalRefs String?  @map("encrypted_external_refs")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([store, storeEventId], map: "purchase_transactions_store_event_key")
  @@index([subscriptionId])
  @@map("purchase_transactions")
}

model Entitlement {
